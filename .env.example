# Market data source: yfinance (default, no key) | fmp | alphavantage
# Restart the app after changing this value.
FINANCIAL_DATA_PROVIDER=yfinance
# Required only when FINANCIAL_DATA_PROVIDER=fmp
FMP_API_KEY=
FMP_BASE_URL=https://financialmodelingprep.com/stable
# Required only when FINANCIAL_DATA_PROVIDER=alphavantage
ALPHA_VANTAGE_API_KEY=

# News search
TAVILY_API_KEY=your_tavily_key

# Model provider: bedrock (default), ollama, or groq
STRANDS_PROVIDER=bedrock
# Bedrock model id, Ollama model name, or Groq model id (for example llama-3.3-70b-versatile)
STRANDS_MODEL=anthropic.claude-3-5-sonnet-20241022-v2:0
# Used only when STRANDS_PROVIDER=ollama
OLLAMA_HOST=http://127.0.0.1:11434

# Provider credentials (set the one matching STRANDS_PROVIDER)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
AWS_REGION=us-east-1

# Cache TTL (seconds)
CACHE_DEFAULT_TTL=3600
CACHE_MAX_SIZE=512
